{
  "env": {
    "ANTHROPIC_BASE_URL": "https://sdf-llm.slac.stanford.edu",
    "ANTHROPIC_SMALL_FAST_MODEL": "copilot-claude-haiku-4.5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "copilot-claude-haiku-4.5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "copilot-claude-sonnet-4.6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "copilot-claude-opus-4.6",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "NO_PROXY": "sdf-llm.slac.stanford.edu,localhost,127.0.0.1",
    "npm_config_proxy": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/strategic-compact/suggest-compact.js"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/skills/strategic-compact/suggest-compact.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); f=$(echo \"$input\" | jq -r \".tool_input.file_path // empty\" 2>/dev/null); [[ \"$f\" == */.claude/skills/*/SKILL.md ]] && printf \"{\\\"tool\\\":\\\"Read\\\",\\\"path\\\":\\\"%s\\\",\\\"timestamp\\\":\\\"%s\\\"}\\n\" \"$f\" \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" >> ~/.claude/observations.jsonl || true'"
          }
        ]
      }
    ]
  },
  "apiKeyHelper": "cat ~/.claude/.token",
  "permissions": {
    "allow": [
      "WebFetch(*)"
    ]
  },
  "skipWebFetchPreflight": true
}
